{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document_content/1.0",
  "title": "DocumentContent",
  "type": "object",
  "required": ["schema_version", "metadata", "blocks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "metadata": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string"},
        "language": {"enum": ["en", "ar", "mixed"]},
        "author": {"type": "string"}
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "text"],
            "additionalProperties": false,
            "properties": {
              "type": {"const": "heading"},
              "text": {"type": "string", "minLength": 1},
              "level": {"type": "integer", "minimum": 1, "maximum": 4}
            }
          },
          {
            "type": "object",
            "required": ["type", "text"],
            "additionalProperties": false,
            "properties": {
              "type": {"const": "paragraph"},
              "text": {"type": "string"},
              "direction": {"enum": ["auto", "ltr", "rtl"]}
            }
          },
          {
            "type": "object",
            "required": ["type", "items"],
            "additionalProperties": false,
            "properties": {
              "type": {"const": "list"},
              "items": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "ordered": {"type": "boolean"}
            }
          },
          {
            "type": "object",
            "required": ["type", "headers", "rows"],
            "additionalProperties": false,
            "properties": {
              "type": {"const": "table"},
              "headers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "rows": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
              "caption": {"type": "string"}
            }
          }
        ]
      }
    }
  }
}
